@startuml as_is_ddd
title Старая Система Умный Дом - Диаграмма контекстов
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(user, "Пользователь", "Пользователь системы управления и мониторинга сенсоров")
Person(sensor_device, "Сенсор", "Физическое устройство, передающее измерения (температура)")

System_Boundary(system, "Система «Управление сенсорами и мониторинг»") {
    System(s1, "Управление сенсорами", "Контекст: управление сенсорами", "Регистрация, конфигурация и управление сенсорами")
    System(s2, "Получение значений", "Контекст: получение значений (температура)", "Сбор, агрегация и выдача измерений (температура)")
}

Rel(user, s1, "управляет/конфигурирует\n(веб UI / API)")
Rel(sensor_device, s2, "отправляет измерения\n(температура)")
Rel(s1, s2, "предоставляет метаданные о сенсорах\n(идентификаторы, конфигурация) / подписывается на данные")
Rel(s2, user, "предоставляет значения и алерты\n(API / WebSocket / UI)")

@enduml